{
  "name": "taskmemoapp",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "fractional-indexing": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "firebase:verify-env": "node ./scripts/verify-firebase-environment.js",
    "firebase:verify-dev-connection": "node ./scripts/verify-dev-firebase-connection.js",
    "firebase:emulator": "npx firebase-tools emulators:start --config firebase.emulator.json --project demo-taskmemo-v2 --only auth,firestore",
    "firebase:prepare-v2-ui": "tsx scripts/prepare-v2-ui-emulator.ts",
    "migration:dry-run": "tsx scripts/migration-dry-run.ts",
    "migration:production-read-only": "node scripts/read-production-v1-snapshot.mjs",
    "migration:analyze-production-snapshot": "tsx scripts/analyze-production-snapshot.ts",
    "migration:intake-v1-export": "tsx scripts/intake-v1-export.ts",
    "migration:repair-approved-v1-export": "tsx scripts/repair-approved-v1-export-source.ts",
    "rehearsal:v2-cutover": "tsx scripts/rehearse-v2-cutover.ts",
    "diagnostics:cutover": "node scripts/analyze-cutover-diagnostics.mjs",
    "verify:final-rc": "npm run verify && npx firebase-tools emulators:exec --config firebase.emulator.json --project demo-taskmemo-v2 --only firestore \"node scripts/run-final-rc-emulator-tests.mjs\"",
    "rc:provision-dev": "node scripts/provision-v2-rc-dev.mjs",
    "web:export": "npm run firebase:verify-env && expo export --platform web --clear && node ./scripts/verify-firebase-web-export.js",
    "web:export:v2-rc": "node ./scripts/build-v2-rc-web.mjs",
    "lint": "expo lint",
    "test": "vitest run",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "verify": "tsc --noEmit && npm run lint && npm test && npm run functions:build && npm run functions:test"
  },
  "private": true
}
