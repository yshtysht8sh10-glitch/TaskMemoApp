    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-notifications": "~57.0.19",
    "expo-router": "~57.0.21",
    "expo-sharing": "~57.0.19",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "fractional-indexing": "^4.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "patch-package": "^8.0.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  },
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "firebase:verify-env": "node ./scripts/verify-firebase-environment.js",
    "firebase:verify-dev-connection": "node ./scripts/verify-dev-firebase-connection.js",
    "web:export": "npm run firebase:verify-env && expo export --platform web --clear && node ./scripts/verify-firebase-web-export.js",
    "lint": "expo lint",
    "test": "vitest run",
    "functions:build": "npm --prefix functions run build",
    "functions:test": "npm --prefix functions test",
    "verify": "tsc --noEmit && npm run lint && npm test && npm run functions:build && npm run functions:test"
  },
  "private": true
}
