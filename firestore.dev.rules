rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function ownsUser(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function protocolSelected(userId, protocol) {
      let gate = get(/databases/$(database)/documents/users/$(userId)/syncMetadataV2/compatibility).data;
      return gate.schemaVersion == 1
        && ((protocol == 1 && gate.minimumSyncProtocol == 1
          && gate.v1WritesAllowed == true && gate.v2Enabled == false)
        || (protocol == 2 && gate.minimumSyncProtocol == 2
          && gate.v1WritesAllowed == false && gate.v2Enabled == true));
    }

    function protocolWritable(userId, protocol) {
      let global = get(/databases/$(database)/documents/syncControl/current).data;
      return global.schemaVersion == 1 && global.writesEnabled == true && protocolSelected(userId, protocol);
    }

    match /syncControl/current {
      allow read: if request.auth != null;
      allow write: if false;
    }

    function validVersionedRecord(nodeId) {
      let record = request.resource.data.record;
      return request.resource.data.keys().hasAll(['ownerUid', 'schemaVersion', 'record'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'record', 'serverUpdatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 2
        && record is map
        && record.keys().hasAll(['value', 'revision', 'lastOpId', 'lastDeviceId', 'lastLocalSeq', 'operationType'])
        && record.value is map
        && record.value.id == nodeId
        && record.revision is int && record.revision >= 0
        && record.lastOpId is string && record.lastOpId.size() > 0
        && record.lastDeviceId is string && record.lastDeviceId.size() > 0
        && record.lastLocalSeq is int && record.lastLocalSeq >= 0
        && record.operationType is string;
    }

    function validPinnedNoteRecord() {
      let record = request.resource.data.record;
      return request.resource.data.keys().hasAll(['ownerUid', 'schemaVersion', 'record'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'record', 'serverUpdatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 2
        && record is map
        && record.keys().hasAll(['value', 'revision', 'lastOpId', 'lastDeviceId', 'lastLocalSeq'])
        && record.value is map
        && record.value.body is string
        && record.revision is int && record.revision >= 0
        && record.lastOpId is string && record.lastOpId.size() > 0
        && record.lastDeviceId is string && record.lastDeviceId.size() > 0
        && record.lastLocalSeq is int && record.lastLocalSeq >= 0;
    }

    function validFeaturesRecord() {
      let record = request.resource.data.record;
      return request.resource.data.keys().hasAll(['ownerUid', 'schemaVersion', 'record'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'record', 'serverUpdatedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 2
        && record is map
        && record.keys().hasAll(['value', 'revision', 'lastOpId', 'lastDeviceId', 'lastLocalSeq'])
        && record.value is map
        && record.value.keys().hasOnly(['ideasEnabled'])
        && record.value.ideasEnabled is bool
        && record.revision is int && record.revision >= 0
        && record.lastOpId is string && record.lastOpId.size() > 0
        && record.lastDeviceId is string && record.lastDeviceId.size() > 0
        && record.lastLocalSeq is int && record.lastLocalSeq >= 0;
    }

    function validOperation(opId) {
      let operation = request.resource.data.operation;
      let acknowledgement = request.resource.data.acknowledgement;
      return request.resource.data.keys().hasAll(['ownerUid', 'schemaVersion', 'operation', 'acknowledgement'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'schemaVersion', 'producerType', 'operation', 'acknowledgement', 'serverReceivedAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.schemaVersion == 2
        && operation is map
        && operation.keys().hasAll(['opId', 'deviceId', 'localSeq', 'targetNodeId', 'type', 'baseRevision', 'payload', 'createdAt', 'status', 'attemptCount'])
        && operation.opId == opId
        && operation.deviceId is string && operation.deviceId.size() > 0
        && operation.localSeq is int && operation.localSeq > 0
        && operation.targetNodeId is string && operation.targetNodeId.size() > 0
        && operation.baseRevision is int && operation.baseRevision >= 0
        && operation.payload is map
        && ((operation.targetType == 'pinnedNote'
          && operation.targetNodeId == 'pinnedNote'
          && operation.payload.pinnedNote is map
          && operation.payload.pinnedNote.body is string)
        || (operation.targetType == 'features'
          && operation.targetNodeId == 'features'
          && operation.payload.features is map
          && operation.payload.features.keys().hasOnly(['ideasEnabled'])
          && operation.payload.features.ideasEnabled is bool)
        || ((!operation.keys().hasAny(['targetType']) || operation.targetType == 'node')
          && operation.payload.node is map
          && operation.payload.node.id == operation.targetNodeId))
        && acknowledgement is map && acknowledgement.opId == opId;
    }

    // Existing v1 client remains available only to the authenticated owner.
    match /users/{userId}/nodes/{nodeId} {
      allow read: if ownsUser(userId) && protocolSelected(userId, 1);
      allow write: if ownsUser(userId) && protocolWritable(userId, 1);
    }
    match /users/{userId}/externalAiAuditLogs/{logId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }
    match /users/{userId}/syncMetadataV2/{documentId} {
      allow read: if ownsUser(userId);
      allow write: if false;
    }

    match /users/{userId}/nodesV2/{nodeId} {
      allow read: if ownsUser(userId) && protocolSelected(userId, 2);
      allow create: if ownsUser(userId) && protocolWritable(userId, 2) && validVersionedRecord(nodeId);
      allow update: if ownsUser(userId)
        && protocolWritable(userId, 2)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validVersionedRecord(nodeId)
        && request.resource.data.record.revision >= resource.data.record.revision;
      allow delete: if false;
    }
    match /users/{userId}/profileV2/pinnedNote {
      allow read: if ownsUser(userId) && protocolSelected(userId, 2);
      allow create: if ownsUser(userId) && protocolWritable(userId, 2) && validPinnedNoteRecord();
      allow update: if ownsUser(userId)
        && protocolWritable(userId, 2)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validPinnedNoteRecord()
        && request.resource.data.record.revision >= resource.data.record.revision;
      allow delete: if false;
    }
    match /users/{userId}/profileV2/features {
      allow read: if ownsUser(userId) && protocolSelected(userId, 2);
      allow create: if ownsUser(userId) && protocolWritable(userId, 2) && validFeaturesRecord();
      allow update: if ownsUser(userId)
        && protocolWritable(userId, 2)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validFeaturesRecord()
        && request.resource.data.record.revision >= resource.data.record.revision;
      allow delete: if false;
    }
    match /users/{userId}/syncOperationsV2/{opId} {
      allow read: if ownsUser(userId) && protocolSelected(userId, 2);
      allow create: if ownsUser(userId) && protocolWritable(userId, 2) && validOperation(opId);
      // Operation receipts are immutable; this preserves the opId idempotency boundary.
      allow update, delete: if false;
    }
    // Functions use Admin SDK and must validate gate, UID, request identity and
    // revision inside their transaction. Client SDK access is never allowed.
    match /users/{userId}/externalAiRequestsV2/{requestId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
