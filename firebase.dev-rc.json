{
  "firestore": { "rules": "firestore.dev.rules" },
  "functions": { "source": "functions", "runtime": "nodejs22" },
  "hosting": {
    "site": "taskmemoapp-dev",
    "public": "dist",
    "ignore": ["firebase.dev-rc.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
