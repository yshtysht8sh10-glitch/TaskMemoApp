# Required: development, production, or test.
EXPO_PUBLIC_TASKMEMO_ENV=development
# Opt-in only. Production ignores this flag. Never enable in production builds.
EXPO_PUBLIC_SYNC_V2_ENABLED=false
# Local browser + Auth/Firestore emulators only (demo-taskmemo-v2).
EXPO_PUBLIC_FIREBASE_EMULATOR=false

# Firebase client configuration for the selected environment.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Remote MCP base URL. Leave empty until the Function is deployed.
EXPO_PUBLIC_TASKMEMO_MCP_BASE_URL=
