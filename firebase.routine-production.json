{
  "hosting": {
    "site": "taskmemoapp-eabc3",
    "public": "dist",
    "ignore": ["firebase.routine-production.json", "**/.*", "**/node_modules/**"],
    "cleanUrls": true,
    "headers": [
      { "source": "/storage-diagnostics", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
      { "source": "/storage-diagnostics.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
      { "source": "/storage-diagnostics.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
      { "source": "/v2-recovery-backup", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
      { "source": "/v2-recovery-backup.html", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] },
      { "source": "/v2-recovery-backup.js", "headers": [{ "key": "Cache-Control", "value": "no-store, max-age=0" }] }
    ],
    "rewrites": [{ "source": "**", "destination": "/index.html" }]
  }
}
